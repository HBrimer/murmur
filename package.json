{
  "name": "murmur",
  "productName": "Murmur",
  "version": "0.1.0",
  "description": "Private, offline transcription and summaries. Your audio never leaves your machine.",
  "author": "Harrison Brimer",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "fetch-deps": "node scripts/fetch-deps.js",
    "predist": "node scripts/fetch-deps.js",
    "dist": "electron-builder",
    "test": "node --test"
  },
  "build": {
    "appId": "com.murmur.app",
    "productName": "Murmur",
    "files": ["src/**/*", "package.json"],
    "extraResources": [
      { "from": "bin", "to": "bin", "filter": ["**/*"] },
      { "from": "models", "to": "models", "filter": ["**/*"] }
    ],
    "win": { "target": "nsis", "icon": "build/icon.ico", "artifactName": "Murmur-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false },
    "mac": { "target": "dmg", "category": "public.app-category.productivity" },
    "linux": { "target": "AppImage", "category": "Office" }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.17.0"
  }
}
